# Copy this file to .env and fill in real values (never commit .env)

PORT=3000
NODE_ENV=development

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=m.boutiquehomes
DB_PASSWORD=change-me
DB_NAME=m.boutiquehomes

# Admin sign-in: admins live in the database (dashboard → 管理员). The owner's passcode is set with:  npm run set-admin
# ADMIN_PASSWORD_HASH below is only read ONCE, to move an old single passcode into the database; you can leave it empty.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Secret used to sign the admin login cookie (set-admin generates one if empty)
JWT_SECRET=
