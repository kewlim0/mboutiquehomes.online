<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Pulls the server's backups to this Mac once a day (see scripts/BACKUP.md). Install: copy to ~/Library/LaunchAgents/ and launchctl bootstrap. -->
<plist version="1.0">
<dict>
    <key>Label</key><string>com.mboutiquehomes.pull-backups</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/admin/Documents/Portfolio Website/scripts/pull-backups.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>30</integer></dict>
    <key>StandardOutPath</key><string>/Users/admin/Backups/mboutiquehomes-pull.log</string>
    <key>StandardErrorPath</key><string>/Users/admin/Backups/mboutiquehomes-pull.log</string>
</dict>
</plist>
